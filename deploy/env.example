# Copy to /var/www/tradoor/.env on the server. Use hex secrets — the password goes
# into a connection URL:  openssl rand -hex 24
POSTGRES_USER=tradoor
POSTGRES_PASSWORD=
POSTGRES_DB=tradoor
# The loopback port nginx proxies to.
TRADOOR_PORT=8080
# A Telegram bot's token, from @BotFather, for alerts sent to a chat. It must
# also be named in compose.yml's environment to reach the program — it is.
# TRADOOR_TELEGRAM_TOKEN=
# Footprint history read from Binance's archive of every trade, as
# market@first-day, comma-separated. Unset, compose.yml reads BTCUSDT perpetual
# from 2026; empty reads none.
# TRADOOR_FOOTPRINT_HISTORY=binance-perp:BTCUSDT@2026-01-01
# The image to run. Deploys from GitHub Actions set this to the commit they ship;
# a manually loaded image is tradoor:latest.
# TRADOOR_IMAGE=tradoor:latest
