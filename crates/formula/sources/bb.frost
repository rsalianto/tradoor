// Bollinger Bands
// A simple average, with a band on each side as far as `mult` standard
// deviations of the closes around it. Narrow bands are the quiet before a move.
input length = 20 min 2 max 1000 "Length"
input mult = 2 min 0.1 max 10 step 0.1 "Multiplier"
basis = sma(close, length)
spread = mult * stdev(close, length)
plot(basis + spread, "Upper", blue)
plot(basis, "Basis", orange)
plot(basis - spread, "Lower", blue)
fill("Upper", "Lower", blue)
