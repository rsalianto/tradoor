// Keltner Channels
// An exponential average, with a band on each side `mult` times the average
// true range away. It follows how far bars range, not where they close.
input length = 20 min 2 max 1000 "Length"
input mult = 2 min 0.1 max 10 step 0.1 "Multiplier"
input atrLength = 10 min 1 max 1000 "ATR length"
basis = ema(close, length)
spread = mult * atr(atrLength)
plot(basis + spread, "Upper", blue)
plot(basis, "Basis", blue)
plot(basis - spread, "Lower", blue)
fill("Upper", "Lower", blue)
