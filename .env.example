POSTGRES_USER=tradoor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradoor
DATABASE_URL=postgres://tradoor:change-me@127.0.0.1:5438/tradoor
# Where candle partitions are written and served from.
TRADOOR_DATA_DIR=./data
TRADOOR_BIND=127.0.0.1:8080

# Optional.
# Serve the built web app from tradoor-server instead of nginx.
# TRADOOR_WEB_DIR=./web/dist
# Tickers whose liquidations the server keeps for 24 hours, from every perpetual
# exchange; empty turns it off. Defaults to BTCUSDT,ETHUSDT,SOLUSDT.
# TRADOOR_LIQUIDATIONS=BTCUSDT,ETHUSDT,SOLUSDT
# Seconds between recorder passes.
# TRADOOR_RECORDER_INTERVAL=600
# Footprint history read from Binance's archive of every trade, as
# market@first-day, comma-separated: a month at a time, each file deleted once
# read. Unset reads none; the history is then what the server recorded.
# TRADOOR_FOOTPRINT_HISTORY=binance-perp:BTCUSDT@2026-01-01
# Binance's market-data mirror, for networks where api.binance.com is unreachable.
# BINANCE_SPOT_REST=https://data-api.binance.vision
# A Telegram bot's token, from @BotFather, for alerts sent to a chat. Without it
# the Telegram section of Settings says the server has no bot. Each reader links
# their own chat from Settings; the token is the server's and is never logged.
# TRADOOR_TELEGRAM_TOKEN=
